# Copy to .env (never commit .env). All values below are placeholders.

# Backend
INTENTGATE_ENV=production
INTENTGATE_HOST=127.0.0.1
INTENTGATE_PORT=8000
INTENTGATE_DB_PATH=backend/data/intentgate.db
# Long random string; signs challenge approval grants. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
INTENTGATE_SIGNING_KEY=change-me
# Protects operator-only endpoints (global reset, audit maintenance).
INTENTGATE_OPERATOR_TOKEN=change-me
# Comma-separated list of allowed browser origins for CORS.
INTENTGATE_CORS_ORIGINS=http://localhost:5173
# Approval grant lifetime in seconds.
INTENTGATE_APPROVAL_TTL_S=120

# Frontend (Vite)
VITE_API_BASE=http://localhost:8000
